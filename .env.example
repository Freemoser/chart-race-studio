# Kopie als .env.local anlegen und ausfüllen. Ohne Wert bleibt die jeweilige Integration aus.
# In GitHub Actions als Repository-Variablen hinterlegen (Settings → Secrets and variables → Actions → Variables).

# Öffentliche Adresse der Seite, z. B. https://freimoser.github.io/chart-race-studio
VITE_SITE_URL=

# Google Analytics 4 – Messkennung. Setzt Cookies, erscheint nur mit Einwilligung.
VITE_GA_ID=

# Cloudflare Web Analytics – Token aus dem Dashboard. Cookielos.
VITE_CF_BEACON=

# Google Search Console – Inhalt des Meta-Tags google-site-verification
VITE_GSC_VERIFICATION=
